{
	auto_https off
	servers {
		# Tailscale serve/funnel proxies from localhost; keep the real client IP.
		trusted_proxies static 127.0.0.1/32
	}
}

# Public, reached through Tailscale Funnel on :443.
:8081 {
	# Phones POST locations here.
	handle /pub {
		# Generated by `fgps add/remove`: a basic_auth block with one login per family member.
		import /etc/caddy/auth/users.caddy
		reverse_proxy recorder:8083 {
			# Store points under the authenticated user, whatever the app claims.
			header_up X-Limit-U {http.auth.user.id}
		}
	}
	# Everything else is ntfy (alerts). It has its own logins; anonymous access is denied.
	handle {
		reverse_proxy ntfy:80
	}
}

# Private, tailnet only (:8443). Map and history.
:8080 {
	reverse_proxy frontend:80
}
